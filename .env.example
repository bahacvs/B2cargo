# Axiom Logistics Intelligence — ortam değişkenleri örneği
# Geliştirmede USE_MOCK_ADAPTERS=true yeterlidir; harici API anahtarı gerekmez.

DATABASE_URL=postgresql://user:pass@localhost:5432/axiom
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Stok/sevkiyat kaynağı: Omnia (ana). Devambar artık sadece DB (bağlantı TBD).
STOCK_SOURCE=omnia
OMNIA_API_URL=https://...
OMNIA_API_KEY=...
DEVAMBAR_API_URL=https://...      # sadece veritabanı; erişim sonra netleşecek
DEVAMBAR_API_KEY=...
SENSOR_API_URL=https://...
SENSOR_API_KEY=...
ARVENTO_API_URL=https://...
ARVENTO_API_KEY=...

# Bildirim teslimi (aciliyet skoruna göre WhatsApp / Telegram)
USE_MOCK_NOTIFIERS=true
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
WHATSAPP_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_RECIPIENT=...

USE_MOCK_ADAPTERS=true
TIMEZONE=Europe/Istanbul
LOG_LEVEL=INFO
