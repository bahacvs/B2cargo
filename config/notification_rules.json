{
  "_comment": "Aciliyet (risk seviyesi) → kanal eşlemesi. NotificationBuilder bunu kullanır, delivery katmanı gönderir. Kritik en yüksek aciliyet: WhatsApp + Telegram. Düşük: bildirim yok.",
  "channels": {
    "CRITICAL": ["whatsapp", "telegram"],
    "HIGH": ["telegram"],
    "MEDIUM": ["dashboard"],
    "LOW": []
  },
  "throttle": {
    "per_depot_minutes": 30,
    "max_per_run": 50
  },
  "templates": {
    "critical_temp": "KRİTİK: {depot_name} - {item_name} sıcaklık sapması ({measured_c}°C).",
    "daily_summary": "Günlük rapor: {depot_name} - {critical_count} kritik, {high_count} yüksek risk."
  }
}
